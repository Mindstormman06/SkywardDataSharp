<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SkywardDataSharp</RootNamespace>
    <AssemblyName>SkywardDataSharp</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Aiden A</Authors>
    <Description>Skyward Sword HD game data files: event lists (zev.dat), JStudio cutscenes (.stb), camera parameters, polygon codes, enemy sheets and map tables.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

</Project>
